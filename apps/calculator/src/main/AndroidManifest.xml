<?xml version="1.0" encoding="utf-8"?>
<!--
  Calculator of BBOS 7.1: an ordinary app, out of the module,
  installed by tools/install.sh. No permission, nothing stored, nothing exported but its launcher
  activity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Switch Application of the menus: the launcher's switcher, behind its
         signature permission, declared here and by the launcher and each app that asks for it, so
         that the order of the installs does not matter. -->
    <permission
        android:name="dev.bold7.permission.SWITCH_APPLICATION"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.bold7.permission.SWITCH_APPLICATION" />

    <!-- Help of the menus (dev.bold7.ui.Help): Help's signature permission, declared here and by
         Help, so that the order of the installs does not matter. -->
    <permission
        android:name="dev.bold7.permission.HELP"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.bold7.permission.HELP" />
    <application
        android:name=".CalcApp"
        android:allowBackup="false"
        android:label="@string/app_name">

        <activity
            android:name=".CalcActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
