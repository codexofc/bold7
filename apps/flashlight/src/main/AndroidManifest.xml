<?xml version="1.0" encoding="utf-8"?>
<!--
  Flashlight of Bold7: an ordinary app, out of the module, installed by
  tools/install.sh. No permission (CameraManager.setTorchMode needs none), nothing stored, no
  service, nothing exported but its launcher activity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Switch Application of the menus: the launcher's switcher, behind its
         signature permission, declared here and by the launcher and each app that asks for it, so
         that the order of the installs does not matter. -->
    <permission
        android:name="dev.bold7.permission.SWITCH_APPLICATION"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.bold7.permission.SWITCH_APPLICATION" />

    <!-- Its own pictogram (ic_flashlight, D: the 9900 had no lamp), which the grid puts on OS 7's
         tile (core/icons Tile.kt); never the Bold7 logo. -->
    <application
        android:name=".FlashApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        tools:replace="android:icon,android:roundIcon">

        <activity
            android:name=".FlashActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
