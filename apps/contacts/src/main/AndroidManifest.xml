<?xml version="1.0" encoding="utf-8"?>
<!--
  Contacts of BBOS 7.1 (docs/BBOS7-VISUEL.md §30): an ordinary app over Android's contacts
  provider, out of the module, installed by tools/install.sh. Every contact stays where it is (the
  Google account's sync keeps it); the app keeps nothing of its own.
  Exported: the launcher's activity; Select Contact for Bold7's apps by name (a signature
  permission); and, without a permission because other apps start them by implicit intent, Select
  Contact (pick), New Contact (insert) and the opener of a contact (view, edit) of Android's
  contacts contract (the allowed exception to the export rule of CONTRIBUTING.md): each shows a screen to the user and returns or
  writes nothing without his click or his Save. Nothing is shown over the lock screen.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Switch Application of the menus: the launcher's switcher, behind its
         signature permission, declared here and by the launcher and each app that asks for it, so
         that the order of the installs does not matter. -->
    <permission
        android:name="dev.bold7.permission.SWITCH_APPLICATION"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.bold7.permission.SWITCH_APPLICATION" />

    <!-- Select Contact (ACTION_PICK of a contact or of a number), for Bold7's apps: all signed by
         the release key. Declared here and by each app that asks for it, so that the order of the
         installs does not matter. -->
    <permission
        android:name="dev.bold7.permission.SELECT_CONTACT"
        android:protectionLevel="signature" />
    <!-- Messages' new text to a number (apps/messages, its Compose alias). -->
    <permission
        android:name="dev.bold7.permission.COMPOSE_TEXT"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.bold7.permission.COMPOSE_TEXT" />
    <!-- Messages' new mail to an address (apps/messages, its ComposeEmail alias). -->
    <permission
        android:name="dev.bold7.permission.COMPOSE_EMAIL"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.bold7.permission.COMPOSE_EMAIL" />

    <!-- Runtime, granted by tools/install.sh (grant_permissions). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Call places the call through Telecom, whose DIALER holder shows it. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Package visibility (Android 11+): Messages' Compose and the email app of Email. -->
    <queries>
        <package android:name="dev.bold7.messages" />
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <!-- No backup: it shows contacts (it stores none). -->
    <application
        android:name=".ContactsApp"
        android:allowBackup="false"
        android:label="@string/app_name">

        <!-- The home's Contacts icon. Its rows=N extra only shows made-up contacts, never written. -->
        <activity
            android:name=".ContactsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Select Contact: started by its explicit name with ACTION_PICK (Contacts.CONTENT_URI, or
             Phone.CONTENT_URI for a number); no intent filter, so that other apps' pickers stay
             Android's without a chooser. In its caller's task, which gets its result. -->
        <activity
            android:name=".SelectContactActivity"
            android:exported="true"
            android:permission="dev.bold7.permission.SELECT_CONTACT"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Select Contact for the other apps: ACTION_PICK and ACTION_GET_CONTENT of a contact, a
             number or an email address. The result is a URI with a read grant, rendered only on the
             user's click. Android's choice of app appears once; "Always" settles it. -->
        <activity
            android:name=".PickContactActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/phone_v2" />
                <data android:mimeType="vnd.android.cursor.dir/email_v2" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.GET_CONTENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/phone_v2" />
                <data android:mimeType="vnd.android.cursor.item/email_v2" />
            </intent-filter>
        </activity>

        <!-- New Contact for the other apps ("Add to contacts"): the form prefilled with their
             extras, nothing written before Save. Its id extra is never read. -->
        <activity
            android:name=".InsertContactActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/contact" />
                <data android:mimeType="vnd.android.cursor.dir/raw_contact" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT_OR_EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/contact" />
                <data android:mimeType="vnd.android.cursor.item/raw_contact" />
            </intent-filter>
        </activity>

        <!-- View or edit a contact from another app: no screen, it starts the card or the form. -->
        <activity
            android:name=".OpenContactActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="com.android.contacts" android:pathPrefix="/contacts/" android:mimeType="vnd.android.cursor.item/contact" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CardActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity
            android:name=".EditActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateHidden" />
    </application>
</manifest>
