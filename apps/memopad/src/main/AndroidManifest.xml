<?xml version="1.0" encoding="utf-8"?>
<!--
  MemoPad of BBOS 7.1: an ordinary app, out of the module, installed
  by tools/install.sh. The memos live in the app's own SQLite database; no permission, no network.
  Nothing exported but the launcher's activity.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Switch Application of the menus: the launcher's switcher, behind its
         signature permission, declared here and by the launcher and each app that asks for it, so
         that the order of the installs does not matter. -->
    <permission
        android:name="dev.bold7.permission.SWITCH_APPLICATION"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.bold7.permission.SWITCH_APPLICATION" />

    <!-- No backup: the memos stay on the phone, in the app's private storage. -->
    <application
        android:name=".MemoApp"
        android:allowBackup="false"
        android:label="@string/app_name">

        <activity
            android:name=".MemoListActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".EditActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <activity
            android:name=".OptionsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
    </application>
</manifest>
