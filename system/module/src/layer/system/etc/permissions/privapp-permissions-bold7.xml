<?xml version="1.0" encoding="utf-8"?>
<!-- Privileged permissions of Bold7's priv-apps (ro.control_privapp_permissions=enforce: a
     privileged permission requested and missing here stops the boot). Frozen and minimal: every
     permission added is justified in its commit. It follows the manifests exactly, one line per
     uses-permission: the module build fails otherwise (tools/privapp_check.py). -->
<permissions>
    <!-- The launcher as recents provider (measured on the Q25): MANAGE_ACTIVITY_TASKS is
         signature|recents on the Q25; READ_FRAME_BUFFER left with the task snapshots, MONITOR_INPUT with
         the gestures (OS 7 has neither). Its recent tasks (SystemRecentTasks):
         START_TASKS_FROM_RECENTS is signature|privileged|recents, REMOVE_TASKS
         signature|recents|role. All granted to the recents provider; listed because the build
         demands a line for every uses-permission. Its app openings:
         CONTROL_REMOTE_APP_TRANSITION_ANIMATIONS is signature|privileged, not recents, on the
         Q25: granted by this line alone. The search's READ_* are runtime
         permissions granted by tools/install.sh, MANAGE_EXTERNAL_STORAGE is preinstalled: their
         lines change nothing for Android, privapp_check.py demands one per uses-permission. Its
         Hub page: dev.bold7.permission.READ_HUB is Bold7's signature
         permission, declared by dev.bold7.hub; same here, and for CALL_PROMPT, declared by
         dev.bold7.phone ("Call …?" of a missed call), and for TYPING_OPTIONS, declared by
         dev.bold7.saisie (Options' Word Learning and Word Substitution). The banner's ACCESS_NETWORK_STATE and Delete's REQUEST_DELETE_PACKAGES and SET_WALLPAPER_HINTS of the home's wallpaper size, and SET_WALLPAPER of the Setup Wizard, are normal: same. Its sound profiles: ACCESS_NOTIFICATION_POLICY is normal: same. Manage
         Connections: MODIFY_PHONE_STATE (signature|privileged|role, the radio)
         and WRITE_SECURE_SETTINGS (signature|privileged|development|installer|role, NFC) are
         granted by these lines alone; CHANGE_WIFI_STATE and ACCESS_WIFI_STATE are normal and
         BLUETOOTH_CONNECT a runtime permission granted by tools/install.sh: same as the search's. Options >
         Wi-Fi Network: OVERRIDE_WIFI_CONFIG (signature|privileged|knownSigner) lets it
         connect to or forget a network Android's Settings saved, granted by this line alone (after a
         reboot with the module); ACCESS_FINE_LOCATION and ACCESS_COARSE_LOCATION are runtime, granted
         by tools/install.sh: same as the search's. Options > Date and Time and Language:
         SET_TIME_ZONE (signature|privileged|role, AlarmManager.setTimeZone) and
         CHANGE_CONFIGURATION (signature|privileged|development|role, LocalePicker.updateLocales),
         granted by these lines alone. Options > Home Screen Preferences: READ_WALLPAPER_INTERNAL
         (signature|privileged), the wallpaper's thumbnail, granted by this line alone. -->
    <privapp-permissions package="dev.bold7.launcher">
        <permission name="android.permission.ACCESS_NETWORK_STATE" />
        <permission name="android.permission.ACCESS_COARSE_LOCATION" />
        <permission name="android.permission.ACCESS_FINE_LOCATION" />
        <permission name="android.permission.ACCESS_NOTIFICATION_POLICY" />
        <permission name="android.permission.ACCESS_WIFI_STATE" />
        <permission name="android.permission.BLUETOOTH_CONNECT" />
        <permission name="android.permission.CHANGE_CONFIGURATION" />
        <permission name="android.permission.CHANGE_WIFI_STATE" />
        <permission name="android.permission.CONTROL_REMOTE_APP_TRANSITION_ANIMATIONS" />
        <permission name="android.permission.MANAGE_ACTIVITY_TASKS" />
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE" />
        <permission name="android.permission.MODIFY_PHONE_STATE" />
        <permission name="android.permission.OVERRIDE_WIFI_CONFIG" />
        <permission name="android.permission.READ_CALENDAR" />
        <permission name="android.permission.READ_CALL_LOG" />
        <permission name="android.permission.READ_CONTACTS" />
        <permission name="android.permission.READ_SMS" />
        <permission name="android.permission.READ_WALLPAPER_INTERNAL" />
        <permission name="android.permission.REMOVE_TASKS" />
        <permission name="android.permission.REQUEST_DELETE_PACKAGES" />
        <permission name="android.permission.SET_TIME_ZONE" />
        <permission name="android.permission.SET_WALLPAPER_HINTS" />
        <permission name="android.permission.SET_WALLPAPER" />
        <permission name="android.permission.START_TASKS_FROM_RECENTS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="dev.bold7.permission.CALL_PROMPT" />
        <permission name="dev.bold7.permission.READ_HUB" />
        <permission name="dev.bold7.permission.TYPING_OPTIONS" />
    </privapp-permissions>
    <!-- Hidden APIs (RemoteAnimationTarget, ATMS...) for this package only, instead of
         AndroidHiddenApiBypass; the global hidden_api_policy is never touched. -->
    <hidden-api-whitelisted-app package="dev.bold7.launcher" />
</permissions>
