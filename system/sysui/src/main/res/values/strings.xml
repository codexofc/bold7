         their message and OK. "The password was not changed." when Android refuses is mine (D). -->
    <string name="password_current">Enter Password:</string>
    <string name="password_new">New Password:</string>
    <string name="password_confirm">Verify New Password:</string>
    <string name="password_sequence">The password cannot be a sequence.</string>
    <string name="password_mismatch">The passwords that you typed are not the same.</string>
    <string name="password_not_set">The password was not changed.</string>
    <string name="password_ok">OK</string>
