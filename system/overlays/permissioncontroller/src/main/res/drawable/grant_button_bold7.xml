<?xml version="1.0" encoding="utf-8"?>
<!-- A button of the permission request, drawn as the framework's dialog buttons (Bold7Android,
     drawable/dialog_button_bold7.xml; docs/BBOS7-VISUEL.md §12): border_button.png, border_button~focus.png
     under the trackpad focus and while pressed (D), the grey one disabled (D, no capture). The
     images are the framework's btn_dialog and title_bar_tall, on which the fabricated overlay
     dev.bold7.launcher:images puts them (Bold7Android, values/dialogs.xml): this overlay carries
     none. A resource of the overlay, not a layout. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@android:drawable/btn_dialog" />
    <item android:state_pressed="true" android:drawable="@android:drawable/title_bar_tall" />
    <item android:state_focused="true" android:drawable="@android:drawable/title_bar_tall" />
    <item android:drawable="@android:drawable/btn_dialog" />
</selector>
