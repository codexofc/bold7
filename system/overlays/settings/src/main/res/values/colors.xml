<?xml version="1.0" encoding="utf-8"?>
<!-- The colours MtkSettings and SettingsLib hard-code, which no system_* role reaches
     (read with aapt2 and apktool from the Q25's MtkSettings.apk; every name here is read
     by the layouts and styles of this overlay). Every value is a token of core/design (Theme,
     Palette, ListColors), BBOS7-VISUEL §19 and §27; SettingsColorsTest (core/design) checks
     each against its token and the text on each surface. The dark pairs are in values-night: an
     overlay value stands for every configuration of its target, so a light value alone would turn
     the dark theme's text black on dark. -->
<resources>
    <!-- The surface and the text of a row: white, black title, #7C7E80 subtitle (Options list, sim-57, C).
         Android's: system_neutral lStar 98, #1E2125 and #4F5155. -->
    <color name="settingslib_surface_light">#ffffffff</color>
    <color name="settingslib_surface_dark">#ff212429</color>
    <color name="settingslib_text_color_primary_device_default">#ff000000</color>
    <color name="settingslib_text_color_secondary_device_default">#ff7c7e80</color>
    <!-- A group's title: grey, as OS 7's (sim-263, C), in place of the accent blue. -->
    <color name="settingslib_text_color_preference_category_title">#ff7c7e80</color>
    <!-- The error of a dialog: OS 7's red, not Google's #D93025. -->
    <color name="settingslib_dialog_colorError">#ffba2121</color>

    <!-- The home page's category icons sit on a coloured disc, a different hue per category, the
         glyph in a darker shade of it: OS 7 has no such hues, so one #212429, the colour of its
         menus, under a white glyph (D). Each category's own pair, not the hues it names
         (homepage_blue_bg...), which Lineage also qualifies with -night. -->
    <color name="homepage_about_background">#ff212429</color>
    <color name="homepage_accessibility_background">#ff212429</color>
    <color name="homepage_accounts_background">#ff212429</color>
