<?xml version="1.0" encoding="utf-8"?>
<!-- The check box of OS 7's lists (docs/BBOS7-VISUEL.md §17): 27x27 cells of
     net_rim_system_Check-icons27x27.png, grey normally, blue under the trackpad focus or the
     finger (the row is selected or pressed), as tools/import-assets.sh dialogues cuts them.
     Reached from the dialog themes (listChoiceIndicatorMultiple), not from a layout. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_pressed="true" android:drawable="@drawable/bold7_check_on_focus" />
    <item android:state_checked="true" android:state_selected="true" android:drawable="@drawable/bold7_check_on_focus" />
    <item android:state_checked="true" android:drawable="@drawable/bold7_check_on" />
    <item android:state_pressed="true" android:drawable="@drawable/bold7_check_off_focus" />
    <item android:state_selected="true" android:drawable="@drawable/bold7_check_off_focus" />
    <item android:drawable="@drawable/bold7_check_off" />
</selector>
