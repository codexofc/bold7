<?xml version="1.0" encoding="utf-8"?>
<!-- No animation: the framework's animation of this name, kept
     under its name so every style and every path that loads it plays nothing. One millisecond of
     full opacity: the window is simply there, or gone. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="1.0"
    android:toAlpha="1.0"
    android:duration="1" />
