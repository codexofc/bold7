<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The 9900's message LED: "Red: a new message has arrived and your
         selected profile is set to notify you using the flashing LED" (user guide 7.1, p. 15,
         M); the simulator's LED is red too (0x3f0000 in its controller's log, C). Android lights
         its notification LED only with this true: false on the Q25, whose lights HAL has the
         notification light (id 4 in dumpsys lights). NotificationManagerService
         reads it at boot, flashes the LED for a notification whose channel asks for lights, with
         this colour when the channel gives none (Google Messages' "Incoming messages"), screen
         off only, and until the notification is gone or its effects cleared. -->
    <bool name="config_intrusiveNotificationLed">true</bool>
    <color name="config_defaultNotificationColor">#ffff0000</color>
    <!-- On 170 ms, off 2040 ms: the blink of the simulator's LED for an incoming call, timed from
         its controller's log (C); the same for a message is my deduction (D). Android's: 500, 2000. -->
    <integer name="config_defaultNotificationLedOn">170</integer>
    <integer name="config_defaultNotificationLedOff">2040</integer>
</resources>
