<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android's notification LED off: the LED is bold7-led's (system/module/led),
         which flashes it as the 9900 does, in the colour the launcher chooses (red for a new
         message whatever the screen, user guide 7.1 p. 15, M). Android would light it screen off
         only, per channel, in the channel's colour, and its lights HAL writing 0 to brightness
         would end a flash. NotificationManagerService reads this at boot; with it false it never
         asks the HAL for the notification light. -->
    <bool name="config_intrusiveNotificationLed">false</bool>
</resources>
