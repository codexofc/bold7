<?xml version="1.0" encoding="utf-8"?>
<!-- BBKB ships these as xhdpi and xxhdpi images, which beat a default density on the Q25
     (208 dpi): anydpi beats them, so the overlay wins. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingDefaultResource">
    <!-- The bar: #282828, flat (sys.keyboard, bkgd-predictionbar-horizontal.png below its
         shadow; the Classic's capture). -->
    <drawable name="keyboard_suggest_strip_holo">#FF282828</drawable>
    <!-- No line between words on the Classic. -->
    <drawable name="suggestions_strip_divider_holo">#00000000</drawable>
</resources>
